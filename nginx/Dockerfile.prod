FROM nginx:1.27-alpine

RUN rm /etc/nginx/conf.d/default.conf
COPY prod.conf /etc/nginx/conf.d/app.conf

# Certs are mounted at /etc/nginx/certs at runtime — see docker-compose.prod.yml.
# /var/www/certbot is the ACME webroot (mount the same dir certbot writes to).

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q --no-check-certificate -O - https://localhost/api/health >/dev/null || exit 1
