{
  "log": { "loglevel": "warning" },

  "inbounds": [
    {
      "tag": "http-in",
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "http",
      "settings": { "allowTransparent": false }
    }
  ],

  "outbounds": [
    {
      "tag": "vless-out",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "REPLACE_VPS_HOST_OR_IP",
            "port": 443,
            "users": [
              {
                "id": "REPLACE_UUID",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "fingerprint": "chrome",
          "serverName": "REPLACE_SNI",
          "publicKey": "REPLACE_PUBLIC_KEY",
          "shortId": "REPLACE_SHORT_ID",
          "spiderX": "/"
        }
      }
    },
    { "tag": "direct", "protocol": "freedom" }
  ],

  "routing": {
    "rules": [
      { "type": "field", "ip": ["geoip:private"], "outboundTag": "direct" }
    ]
  }
}
